<view class="cal" wx:if="{{cal}}">
  <view class="cal-head">
    <text class="cal-title">{{cal.title}}</text>
  </view>

  <view class="cal-week">
    <view class="cal-week-cell" wx:for="{{cal.weekdays}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="cal-row" wx:for="{{cal.weeks}}" wx:for-item="week" wx:key="key">
    <view
      class="cal-cell {{cell.blank ? 'is-blank' : ''}} {{cell.work === true ? 'is-work' : ''}} {{cell.work === false ? 'is-rest' : ''}} {{cell.isToday ? 'is-today' : ''}}"
      wx:for="{{week.cells}}"
      wx:for-item="cell"
      wx:key="key"
      data-day="{{cell.day}}"
      hover-class="{{cell.blank ? 'none' : 'cal-cell-hover'}}"
      bindtap="onDayTap">
      <block wx:if="{{!cell.blank}}">
        <view class="cal-line1">
          <text class="cal-badge {{cell.holidayType === '班' ? 'badge-work' : 'badge-rest'}}" wx:if="{{cell.holidayType}}">{{cell.holidayType}}</text>
          <text class="cal-badge-holder" wx:else></text>
          <text class="cal-num">{{cell.day}}</text>
        </view>
        <view class="cal-text">{{cell.text}}</view>
        <view class="cal-festival">{{cell.holidayName}}</view>
      </block>
    </view>
  </view>

  <view class="cal-tip" wx:if="{{cal.hasHolidayData}}">休＝法定节假日　班＝调休补班　点某一天回到列表</view>
  <view class="cal-tip" wx:else>{{cal.year}} 年的节假日数据尚未内置，格内只显示班况</view>
</view>
