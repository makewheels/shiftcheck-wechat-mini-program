:host {
  display: block;
  width: 100%;
}

.cal {
  width: 100%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.cal-head {
  text-align: center;
  margin-bottom: 6rpx;
}

.cal-title {
  font-size: 34rpx;
  color: #222;
  font-weight: bold;
}

.cal-week {
  display: flex;
}

.cal-week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #888;
  padding: 4rpx 0;
}

.cal-row {
  display: flex;
}

/* 普通日一律白底（2026-09 用户反馈：原来灰底/粉底/绿底不够醒目，
   底色让位给节假日，上班/休息改由字色区分，见 .cal-text） */
.cal-cell {
  flex: 1;
  height: 108rpx;
  margin: 3rpx;
  padding: 4rpx 3rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background-color: #fff;
  overflow: hidden;
}

.cal-cell.is-blank {
  background-color: transparent;
}

/* 法定节假日（休）：浅红底 + 红框 + 红字，「哪天放假」一眼可见但格内班次字色保留 */
.cal-cell.is-holiday {
  background-color: #fdecec;
  border: 2rpx solid #e64340;
}

.cal-cell.is-holiday .cal-num {
  color: #d43a37;
  font-weight: bold;
}

.cal-cell.is-holiday .cal-festival {
  color: #d43a37;
}

/* 框 + 底色本身就是标记，「休」角标藏掉但占位（日期数字不左移） */
.cal-cell.is-holiday .cal-badge {
  visibility: hidden;
}

/* 今天还是绿框；落在节假日格上绿框盖过红框 */
.cal-cell.is-today {
  border: 2rpx solid #1aad19;
}

.cal-cell-hover {
  opacity: 0.6;
}

.cal-line1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 26rpx;
}

.cal-num {
  font-size: 22rpx;
  color: #444;
}

.cal-badge {
  font-size: 18rpx;
  line-height: 24rpx;
  color: #fff;
  border-radius: 4rpx;
  padding: 0 5rpx;
}

/* 调休补班日（班）：白底 + 橙色角标（区别于节假日的红） */
.cal-badge.badge-buaban {
  background-color: #f59f00;
}

.cal-badge-holder {
  width: 10rpx;
}

.cal-text {
  font-size: 20rpx;
  line-height: 26rpx;
  height: 52rpx;
  overflow: hidden;
  text-align: center;
  color: #333;
  margin-top: 2rpx;
  word-break: break-all;
}

/* 上班/休息的区分：不用底色，用字色（红＝上班，绿＝休息） */
.cal-cell.is-work .cal-text {
  color: #cf3b13;
}

.cal-cell.is-rest .cal-text {
  color: #1d7a2c;
}

.cal-festival {
  font-size: 16rpx;
  line-height: 22rpx;
  height: 22rpx;
  text-align: center;
  color: #999;
  overflow: hidden;
}

.cal-tip {
  text-align: center;
  font-size: 20rpx;
  color: #999;
  margin-top: 12rpx;
}
