:host {
  display: block;
  width: 100%;
}

.cal {
  width: 100%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.cal-head {
  text-align: center;
  margin-bottom: 6rpx;
}

.cal-title {
  font-size: 34rpx;
  color: #222;
  font-weight: bold;
}

.cal-week {
  display: flex;
}

.cal-week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #888;
  padding: 4rpx 0;
}

.cal-row {
  display: flex;
}

.cal-cell {
  flex: 1;
  height: 108rpx;
  margin: 3rpx;
  padding: 4rpx 3rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background-color: #f2f2f2;
  overflow: hidden;
}

.cal-cell.is-blank {
  background-color: transparent;
}

.cal-cell.is-work {
  background-color: #fff0ed;
}

.cal-cell.is-rest {
  background-color: #edf9ee;
}

.cal-cell.is-today {
  border: 2rpx solid #1aad19;
}

.cal-cell-hover {
  opacity: 0.6;
}

.cal-line1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 26rpx;
}

.cal-num {
  font-size: 22rpx;
  color: #444;
}

.cal-badge {
  font-size: 18rpx;
  line-height: 24rpx;
  color: #fff;
  border-radius: 4rpx;
  padding: 0 5rpx;
}

.cal-badge.badge-rest {
  background-color: #1aad19;
}

.cal-badge.badge-work {
  background-color: #e64340;
}

.cal-badge-holder {
  width: 10rpx;
}

.cal-text {
  font-size: 20rpx;
  line-height: 26rpx;
  height: 52rpx;
  overflow: hidden;
  text-align: center;
  color: #333;
  margin-top: 2rpx;
  word-break: break-all;
}

.cal-cell.is-work .cal-text {
  color: #cf3b13;
}

.cal-cell.is-rest .cal-text {
  color: #1d7a2c;
}

.cal-festival {
  font-size: 16rpx;
  line-height: 22rpx;
  height: 22rpx;
  text-align: center;
  color: #999;
  overflow: hidden;
}

.cal-tip {
  text-align: center;
  font-size: 20rpx;
  color: #999;
  margin-top: 12rpx;
}
